#!/bin/sh

# Small, fixed-command LuCI helper for OpenWrt 21.02. It replaces the modern
# rpcd-ucode object while preserving a narrow and auditable privilege surface.

. /usr/share/libubox/jshn.sh

HOME_DIR="/etc/nikki"
RUN_PROFILE="$HOME_DIR/run/config.yaml"
TMP_DIR="/var/run/nikki"
DEBUG_LOG="/var/log/nikki/debug.log"
CORE_UPDATER="/etc/nikki/scripts/core_update.sh"
CORE_ACTIVE="/usr/libexec/nikki/mihomo"

json_success() {
	json_init
	json_add_boolean success 1
	json_dump
}

json_failure() {
	json_init
	json_add_boolean success 0
	[ -n "$1" ] && json_add_string error "$1"
	json_dump
}

valid_section_id() {
	case "$1" in
		""|*[!A-Za-z0-9_]* ) return 1 ;;
		*) return 0 ;;
	esac
}

allowed_write_path() {
	case "$1" in
		*'/../'*|*'/..'|*'../'*) return 1 ;;
		/etc/nikki/profiles/*.yaml|/etc/nikki/profiles/*.yml|\
		/etc/nikki/subscriptions/*.yaml|/etc/nikki/subscriptions/*.yml|\
		/etc/nikki/mixin.yaml|/etc/nikki/run/config.yaml|\
		/etc/nikki/run/providers/rule/*|/etc/nikki/run/providers/proxy/*|\
		/var/log/nikki/*.log) return 0 ;;
		*) return 1 ;;
	esac
}

version() {
	local app="" core=""
	if command -v opkg >/dev/null 2>&1; then
		app="$(opkg list-installed luci-app-nikki 2>/dev/null | awk '{print $3; exit}')"
	fi
	if [ -x "$CORE_ACTIVE" ]; then
		core="$("$CORE_ACTIVE" -v 2>/dev/null | sed -n 's/.*\(v[0-9][0-9A-Za-z._+-]*\).*/\1/p' | head -n 1)"
	fi
	json_init
	json_add_string app "$app"
	json_add_string core "$core"
	json_dump
}

add_core_status_fields() {
	local status_file key value tab
	status_file="$TMP_DIR/core-status.$$"
	mkdir -p "$TMP_DIR"
	"$CORE_UPDATER" status > "$status_file" 2>/dev/null || :
	tab="$(printf '\t')"
	while IFS="$tab" read -r key value; do
		case "$key" in
			architecture_uname|architecture_package|current_version|previous_version|latest_version|source|status|error|updated_at|resolved_url|resolved_asset|resolved_repository_base|active_path|previous_path)
				json_add_string "$key" "$value"
				;;
		esac
	done < "$status_file"
	rm -f "$status_file"
}

core_status() {
	json_init
	json_add_boolean success 1
	add_core_status_fields
	json_dump
}

core_action() {
	local action="$1" output rc error
	case "$action" in check|update|rollback|delete-previous) ;; *) json_failure "invalid core action"; return 0 ;; esac
	output="$("$CORE_UPDATER" "$action" 2>&1)"
	rc=$?
	json_init
	if [ "$rc" -eq 0 ]; then
		json_add_boolean success 1
	else
		json_add_boolean success 0
		error="$(printf '%s\n' "$output" | tail -n 1)"
		[ -n "$error" ] && json_add_string error_message "$error"
	fi
	add_core_status_fields
	json_dump
	return 0
}

profile() {
	local defaults="${1:-{}}" defaults_file="$TMP_DIR/profile-defaults.$$"
	mkdir -p "$TMP_DIR"
	[ -r "$RUN_PROFILE" ] || { printf '{}\n'; return 0; }
	trap 'rm -f "$defaults_file"' EXIT INT TERM
	printf '%s' "$defaults" > "$defaults_file"
	if ! yq -M -p json -o json -e '.' "$defaults_file" </dev/null >/dev/null 2>&1; then
		printf '{}\n'
		rm -f "$defaults_file"
		trap - EXIT INT TERM
		return 0
	fi
	yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' "$defaults_file" "$RUN_PROFILE" </dev/null 2>/dev/null || printf '{}\n'
	rm -f "$defaults_file"
	trap - EXIT INT TERM
}

update_subscription() {
	local section="$1"
	valid_section_id "$section" || { json_failure "invalid section id"; return 1; }
	if /etc/init.d/nikki update_subscription "$section" >/dev/null 2>&1; then
		json_success
	else
		json_failure "subscription update failed"
		return 1
	fi
}

api() {
	local method="${1:-GET}" path="${2:-/}" query="${3:-}" body="${4:-}"
	local api_listen api_tls_listen secret protocol listen url output
	[ -r "$RUN_PROFILE" ] || { printf '{}\n'; return 0; }

	api_listen="$(yq -M -r '."external-controller" // ""' "$RUN_PROFILE" 2>/dev/null)"
	api_tls_listen="$(yq -M -r '."external-controller-tls" // ""' "$RUN_PROFILE" 2>/dev/null)"
	secret="$(yq -M -r '.secret // ""' "$RUN_PROFILE" 2>/dev/null)"
	if [ -n "$api_tls_listen" ]; then
		protocol=https
		listen="$api_tls_listen"
	else
		protocol=http
		listen="$api_listen"
	fi
	[ -n "$listen" ] || { printf '{}\n'; return 0; }
	case "$method" in GET|POST|PUT|PATCH|DELETE) ;; *) printf '{}\n'; return 0 ;; esac
	case "$path" in /*) ;; *) printf '{}\n'; return 0 ;; esac

	# A wildcard bind address is valid for Mihomo but not a useful client
	# destination. Contact the local controller through loopback instead.
	case "$listen" in
		0.0.0.0:*) listen="127.0.0.1:${listen##*:}" ;;
		\[::\]:*) listen="127.0.0.1:${listen##*:}" ;;
	esac
	case "$listen" in
		http://0.0.0.0:*) listen="http://127.0.0.1:${listen##*:}" ;;
		https://0.0.0.0:*) listen="https://127.0.0.1:${listen##*:}" ;;
		http://\[::\]:*) listen="http://127.0.0.1:${listen##*:}" ;;
		https://\[::\]:*) listen="https://127.0.0.1:${listen##*:}" ;;
	esac

	case "$listen" in
		http://*|https://*) url="${listen}${path}" ;;
		*) url="${protocol}://${listen}${path}" ;;
	esac
	[ -z "$query" ] || url="${url}?${query}"

	set -- curl -sS --insecure --request "$method" --connect-timeout 5 --max-time 30
	[ -z "$secret" ] || set -- "$@" --oauth2-bearer "$secret"
	[ -z "$body" ] || set -- "$@" --header 'Content-Type: application/json' --data "$body"
	set -- "$@" "$url"
	output="$("$@" 2>/dev/null)" || output='{}'
	printf '%s' "$output" | yq -M -p json -o json -e '.' 2>/dev/null || printf '{}\n'
}

firewall_backend() {
	local fw4_active=0 fw3_active=0 fw4_installed=0 fw3_installed=0 backend="unknown"

	command -v fw4 >/dev/null 2>&1 && fw4_installed=1
	command -v fw3 >/dev/null 2>&1 && fw3_installed=1

	# An active OpenWrt firewall4 instance owns the canonical inet/fw4 table.
	if command -v nft >/dev/null 2>&1 && nft list table inet fw4 >/dev/null 2>&1; then
		fw4_active=1
	fi

	# firewall3 emits characteristic zone/rule chains and !fw3 comments into
	# the active iptables ruleset. Require the fw3 program as well to avoid
	# treating arbitrary compatibility rules on firewall4 systems as fw3.
	if [ "$fw3_installed" -eq 1 ]; then
		if command -v iptables-save >/dev/null 2>&1 && \
			iptables-save 2>/dev/null | grep -Eq '(^:zone_[^ ]+_(input|output|forward) |/\* !fw3 \*/|^-A (input|forwarding|output)_rule )'; then
			fw3_active=1
		elif command -v ip6tables-save >/dev/null 2>&1 && \
			ip6tables-save 2>/dev/null | grep -Eq '(^:zone_[^ ]+_(input|output|forward) |/\* !fw3 \*/|^-A (input|forwarding|output)_rule )'; then
			fw3_active=1
		fi
	fi

	if [ "$fw4_active" -eq 1 ] && [ "$fw3_active" -eq 1 ]; then
		backend="mixed"
	elif [ "$fw4_active" -eq 1 ]; then
		backend="fw4"
	elif [ "$fw3_active" -eq 1 ]; then
		backend="fw3"
	elif [ "$fw4_installed" -eq 1 ]; then
		backend="fw4-stopped"
	elif [ "$fw3_installed" -eq 1 ]; then
		backend="fw3-stopped"
	fi

	json_init
	json_add_string backend "$backend"
	json_dump
}

identifiers() {
	json_init
	json_add_array users
	for item in $(awk -F: 'NF >= 3 && $1 != "" {print $1}' /etc/passwd 2>/dev/null); do
		json_add_string "" "$item"
	done
	json_close_array
	json_add_array groups
	for item in $(awk -F: 'NF >= 3 && $1 != "" {print $1}' /etc/group 2>/dev/null); do
		json_add_string "" "$item"
	done
	json_close_array
	json_add_array cgroups
	json_close_array
	json_dump
}

debug() {
	mkdir -p "$(dirname "$DEBUG_LOG")"
	if /etc/nikki/scripts/debug.sh > "$DEBUG_LOG" 2>&1; then
		json_success
	else
		json_failure "debug collection failed"
		return 1
	fi
}

write_file() {
	local path="$1" data="$2" append="${3:-0}" mode="${4:-644}" final="${5-}" staging
	allowed_write_path "$path" || { json_failure "path is not allowed"; return 1; }
	case "$mode" in ''|*[!0-7]*) mode=644 ;; esac
	case "$append" in 0|1) ;; *) json_failure "invalid append flag"; return 1 ;; esac
	mkdir -p "$(dirname "$path")" || { json_failure "mkdir failed"; return 1; }

	# Compatibility with a pre-5.3 LuCI client, which does not send a final
	# flag. New clients stage every chunk beside the destination and atomically
	# publish the complete file only after the final chunk arrives.
	if [ -z "$final" ]; then
		if [ "$append" = 1 ]; then
			printf '%s' "$data" >> "$path" || { json_failure "write failed"; return 1; }
		else
			printf '%s' "$data" > "$path" || { json_failure "write failed"; return 1; }
		fi
		chmod "$mode" "$path" 2>/dev/null
		json_success
		return 0
	fi

	case "$final" in 0|1) ;; *) json_failure "invalid final flag"; return 1 ;; esac
	staging="${path}.nikki-write"
	if [ "$append" = 1 ]; then
		[ -f "$staging" ] || { json_failure "staged write is missing"; return 1; }
		printf '%s' "$data" >> "$staging" || { json_failure "write failed"; return 1; }
	else
		umask 077
		printf '%s' "$data" > "$staging" || { json_failure "write failed"; return 1; }
	fi
	if [ "$final" = 1 ]; then
		chmod "$mode" "$staging" 2>/dev/null || { rm -f "$staging"; json_failure "chmod failed"; return 1; }
		mv -f "$staging" "$path" || { rm -f "$staging"; json_failure "publish failed"; return 1; }
	fi
	json_success
}

case "$1" in
	version) version ;;
	profile) profile "$2" ;;
	update-subscription) update_subscription "$2" ;;
	core-status) core_status ;;
	core-action) core_action "$2" ;;
	api) api "$2" "$3" "$4" "$5" ;;
	identifiers) identifiers ;;
	firewall-backend) firewall_backend ;;
	debug) debug ;;
	write-file) write_file "$2" "$3" "$4" "$5" "$6" ;;
	*) json_failure "unknown action"; exit 2 ;;
esac
